@model QLThueDoCuoi.ViewModels.TheSanPhamViewModel
@{ ViewBag.Title = Model.TenSanPham; ViewBag.PageKey = "detail"; Layout = "~/Views/Shared/_LayoutKhachHang.cshtml"; }
@* Khung giao diện: dữ liệu mẫu tĩnh. Nhóm phụ trách thay bằng Model lấy từ SQL; chưa có xử lý ghi dữ liệu. *@
<div class="container">
<div class="breadcrumb">
<a class="" href="@Url.Action("Index", "Home", new { area = "" })">Trang chủ</a> <span>/</span> @Model.TenLoai / @Model.TenSanPham</div>
<div class="detail-grid">
<div>
<img class="gallery-main" src="@Url.Content("~" + Model.HinhAnh)" alt="@Model.TenSanPham"/>
<div class="gallery-thumbs">
<img src="@Url.Content("~" + Model.HinhAnh)" alt="@Model.TenSanPham"/>
</div>
</div>
<div class="detail-copy">
<span class="eyebrow">DRAGNEEL SIGNATURE</span>
<h1>@Model.TenSanPham</h1>
<div class="rating">@Model.TenLoai · @Model.Nhan</div>
<div class="detail-price">@(Model.GiaThue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")))₫ <small>/ gói @Model.SoNgayTrongGoi ngày</small>
</div>
<p>Phom dáng thanh lịch, chất liệu nhẹ và những đường nét mềm mại dành cho ngày trọng đại.</p>
<div class="option">
<b>Kích thước</b>
<div class="size-group" data-size-group>
@foreach (var size in Model.KichThuoc.Split(' ')) { <button type="button" aria-pressed="false">@size</button> }
</div>
</div>
<form data-ui-only id="dat-thue">
<div class="option">
<div class="form-grid">
<label class="field">
<span>Màu sắc</span>
<select name="MauSac">
<option>Trắng</option>
</select>
</label>
<label class="field">
<span>Số lượng</span>
<input type="number" name="SoLuong" value="1" min="1" max="10"/>
</label>
<label class="field">
<span>Ngày nhận</span>
<input type="date" name="NgayNhan" value="2026-10-25" />
</label>
<label class="field">
<span>Ngày trả</span>
<input type="date" name="NgayTra" value="2026-10-28" />
</label>
</div>
</div>
<div class="button-row">
<button type="button" class="btn primary" disabled aria-disabled="true">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M5 8h14l1 13H4L5 8Z"/>
<path d="M9 9V6a3 3 0 0 1 6 0v3"/>
</svg> Thêm vào giỏ thuê</button>
<a class="btn" href="@Url.Action("Create", "LichHen", new { area = "", maSanPham = Model.MaSanPham })">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<rect x="3" y="5" width="18" height="16" rx="2"/>
<path d="M7 3v5m10-5v5M3 11h18"/>
</svg> Đặt lịch thử đồ</a>
</div>
</form>
<div class="note">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<circle cx="12" cy="12" r="9"/>
<path d="M12 6v6l4 2"/>
</svg>
<span>Tiền cọc: 2.000.000₫/bộ. Lịch thử đồ và đơn thuê được theo dõi riêng.</span>
</div>
<details class="option">
<summary>Mô tả & chất liệu +</summary>
<p>Organza nhẹ, phom dáng chữ A. Đối chiếu size trước khi đặt thuê.</p>
</details>
<details class="option">
<summary>Chính sách đặt cọc +</summary>
<p>Cọc được theo dõi riêng và hoàn sau khi kiểm tra đồ, đối chiếu các khoản phí.</p>
</details>
<details class="option">
<summary>Giao nhận & hoàn trả +</summary>
<p>Nhận tại showroom hoặc đăng ký giao tận nơi khi đặt thuê.</p>
</details>
</div>
</div>
<section class="section">
<div class="section-head">
<h2>Có thể bạn cũng thích</h2>
</div>
<div class="dragneel-product-grid dragneel-catalog-grid">
@foreach (var sanPham in QLThueDoCuoi.Data.DuLieuGiaoDien.SanPham.Where(x => x.MaSanPham != Model.MaSanPham)) { @await Html.PartialAsync("_TheSanPham", sanPham) }
</div>
</section>
</div>

@section styles { <link rel="stylesheet" href="@Url.Content("~/css/home.css")" /> }
