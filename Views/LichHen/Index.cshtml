@using System
@using System.Collections.Generic
@using System.Linq

@model List<Dictionary<string, object?>>

@{
    ViewData["Title"] = "Lịch hẹn thử đồ của tôi";

    string V(Dictionary<string, object?> r, string k)
        => Convert.ToString(r.GetValueOrDefault(k)) ?? "";

    string Status(string value) => value switch
    {
        "CHO_XAC_NHAN" => "Chờ xác nhận",
        "DA_XAC_NHAN" => "Đã xác nhận",
        "DA_HUY" => "Đã hủy",
        "HOAN_THANH" => "Hoàn thành",
        _ => value.Replace("_", " ")
    };

    var ds = Model ?? new List<Dictionary<string, object?>>();
}

<link rel="stylesheet"
      href="~/css/diem-trang.css"
      asp-append-version="true" />

<main class="lh-page">
    <div class="lh-container">

        <nav class="lh-breadcrumb">
            Trang chủ / Tài khoản / Lịch hẹn thử đồ
        </nav>

        <div class="lh-layout">

            <!-- MENU BEN TRAI -->
            <aside class="lh-sidebar">
                <div class="lh-user">
                    <div class="lh-avatar">D</div>
                    <div>
                        <small>TÀI KHOẢN CỦA BẠN</small>
                        <strong>Khách hàng DRAGNEEL</strong>
                    </div>
                </div>

                <div class="lh-menu">
                    <div class="lh-menu-title">
                        TÀI KHOẢN CỦA TÔI
                    </div>

                    <a class="lh-menu-link active"
                       asp-controller="LichHen"
                       asp-action="Index">
                        ♧ Lịch hẹn thử đồ
                    </a>

                    <a class="lh-menu-link"
                       asp-controller="LichHen"
                       asp-action="Create">
                        ＋ Đặt lịch mới
                    </a>
                </div>
            </aside>

            <!-- NOI DUNG CHINH -->
            <section class="lh-main">

                <div class="lh-heading">
                    <div>
                        <small>TRẢI NGHIỆM CỦA BẠN</small>
                        <h1 class="lh-title-fix">Lịch hẹn thử đồ của tôi</h1>
                        <p>
                            Theo dõi các buổi thử đồ và
                            lịch hẹn của bạn tại DRAGNEEL.
                        </p>
                    </div>

                    <a class="lh-primary"
                       asp-action="Create">
                        Đặt lịch mới ↗
                    </a>
                </div>

                @if (TempData["DiemOk"] != null)
                {
                    <p class="diem-ok">
                        @TempData["DiemOk"]
                    </p>
                }

                @if (TempData["DiemError"] != null)
                {
                    <p class="diem-error">
                        @TempData["DiemError"]
                    </p>
                    }

                <!-- BO LOC -->
                <div class="lh-filters">
                    <button type="button"
                            class="lh-filter active"
                            data-filter="ALL">
                        Tất cả (@ds.Count)
                    </button>

                    <button type="button"
                            class="lh-filter"
                            data-filter="CHO_XAC_NHAN">
                        Chờ xác nhận
                    </button>

                    <button type="button"
                            class="lh-filter"
                            data-filter="DA_XAC_NHAN">
                        Đã xác nhận
                    </button>

                    <button type="button"
                            class="lh-filter"
                            data-filter="DA_HUY">
                        Đã hủy
                    </button>
                </div>

                <!-- DANH SACH LICH HEN -->
                <div class="lh-list">

                    @foreach (var r in ds)
                    {
                        var trangThai = V(r, "TrangThai");

                        var thoiGian = Convert
                            .ToDateTime(r["ThoiDiemHen"])
                            .AddHours(7)
                            .ToString("dd/MM/yyyy · HH:mm");

                        var anh = V(r, "AnhSanPham");

                        <article class="lh-card"
                                 data-status="@trangThai">

                            <div class="lh-card-top">

                                <div class="lh-product">

                                    <div class="lh-image">
                                        @if (!string.IsNullOrWhiteSpace(anh))
                                        {
                                            <img src="@anh"
                                                 alt="@V(r, "TenSanPham")" />
                                        }
                                        else
                                        {
                                            <span>DRAGNEEL</span>
                                        }
                                    </div>

                                    <div class="lh-product-info">
                                        <div class="lh-product-heading">
    <span class="lh-booking-code">
        LH@(V(r, "MaLichHen").PadLeft(4, '0'))
    </span>

    <h3 class="lh-product-name">
        @V(r, "TenSanPham")
    </h3>
</div>

                                        <p>
                                            Sản phẩm:
                                            @V(r, "TenSanPham")
                                        </p>

                                        <p>
                                            ◷ @thoiGian
                                        </p>

                                        <p>
                                          ♧ @V(r, "TenChiNhanh")
                                        </p>
                                    </div>

                                </div>

                                <span class="lh-status"
                                      data-status="@trangThai">
                                    @Status(trangThai)
                                </span>

                            </div>

                            <div class="lh-card-bottom">
                                <p>
                                    Bạn có thể xem thông tin chi tiết
                                    của buổi hẹn tại đây.
                                </p>

                                <div class="lh-card-actions">
                                    <a class="lh-outline"
                                       asp-action="Details"
                                       asp-route-id='@r["MaLichHen"]'>
                                        Xem chi tiết ↗
                                    </a>
                                </div>
                            </div>

                        </article>
                    }

                </div>

                <div class="lh-no-results" hidden>
                    Không có lịch hẹn thuộc trạng thái này.
                </div>

                <div class="lh-note">
                    <span>ⓘ</span>
                    <div>
                        <strong>Chuẩn bị cho buổi hẹn</strong>
                        <p>
                            Mang theo ảnh mẫu yêu thích và
                            đến đúng giờ để có trải nghiệm
                            thử trang phục tốt nhất.
                        </p>
                    </div>
                </div>

            </section>

        </div>
    </div>
</main>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const filters = document.querySelectorAll(".lh-filter");
    const cards = document.querySelectorAll(".lh-card");
    const empty = document.querySelector(".lh-no-results");

    filters.forEach(button => {
        button.addEventListener("click", function () {
            filters.forEach(x => x.classList.remove("active"));
            this.classList.add("active");

            const selected = this.dataset.filter;
            let count = 0;

            cards.forEach(card => {
                const visible = selected === "ALL"
                    || card.dataset.status === selected;

                card.hidden = !visible;
                if (visible) count++;
            });

            if (empty) empty.hidden = count > 0;
        });
    });
});
</script>