@{ ViewBag.Title = "Lịch hẹn thử đồ"; ViewBag.PageKey = "appointments"; Layout = "~/Views/Shared/_LayoutKhachHang.cshtml"; }
@* Khung giao diện: dữ liệu mẫu tĩnh. Nhóm phụ trách thay bằng Model lấy từ SQL; chưa có xử lý ghi dữ liệu. *@
<div class="container">
<div class="breadcrumb">
<a class="" href="@Url.Action("Index", "Home", new { area = "" })">Trang chủ</a> <span>/</span> Tài khoản</div>
<div class="account-layout">@await Html.PartialAsync("_MenuTaiKhoan")<section class="account-content">
<div class="page-head">
<div>
<span class="eyebrow">LỊCH ĐẾN SHOWROOM</span>
<h1>Lịch hẹn thử đồ của tôi</h1>
<p>Theo dõi mẫu đã chọn và lịch đến cửa hàng thử đồ.</p>
</div>
<a class="btn primary" href="@Url.Action("Index", "SanPham", new { area = "" })">+ Đặt lịch thử mới</a>
</div>
<div class="tabs" data-status-group="#appointments-list">
<button type="button" data-status-filter="" class="is-active" aria-pressed="true">Tất cả</button>
<button type="button" data-status-filter="CHO_XAC_NHAN" class="" aria-pressed="false">Chờ xác nhận</button>
<button type="button" data-status-filter="DA_XAC_NHAN" class="" aria-pressed="false">Đã xác nhận</button>
<button type="button" data-status-filter="HOAN_TAT" class="" aria-pressed="false">Đã hoàn thành</button>
<button type="button" data-status-filter="DA_HUY" class="" aria-pressed="false">Đã hủy</button>
</div>
<div id="appointments-list">
<article class="appointment-card" data-status="DA_XAC_NHAN">
<img src="@Url.Content("~/images/dragneel/elodie.svg")" alt="Váy cưới Élodie"/>
<div class="appointment-copy">
<h3>LH001 · Váy cưới Élodie</h3>
<small>Size M · Trắng</small>
<p>
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<rect x="3" y="5" width="18" height="16" rx="2"/>
<path d="M7 3v5m10-5v5M3 11h18"/>
</svg>22/10/2026 · 10:00</p>
<p>
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/>
<circle cx="12" cy="10" r="3"/>
</svg>Showroom DRAGNEEL · 86 Nguyễn Huệ, TP.HCM</p>
</div>
<div class="appointment-actions">
<span class="status green">Đã xác nhận</span>
<div>
<a class="btn small" href="@Url.Action("Details", "LichHen", new { area = "", id = 1 })">Xem chi tiết</a>
<button type="button" class="text-button" data-open-dialog="cancel-appointment">Hủy lịch</button>
</div>
</div>
</article>
<article class="appointment-card" data-status="CHO_XAC_NHAN">
<img src="@Url.Content("~/images/dragneel/aodai.svg")" alt="Áo dài Minh Châu"/>
<div class="appointment-copy">
<h3>LH002 · Áo dài Minh Châu</h3>
<small>Size S · Trắng</small>
<p>
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<rect x="3" y="5" width="18" height="16" rx="2"/>
<path d="M7 3v5m10-5v5M3 11h18"/>
</svg>24/10/2026 · 14:30</p>
<p>
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/>
<circle cx="12" cy="10" r="3"/>
</svg>Showroom DRAGNEEL · 86 Nguyễn Huệ, TP.HCM</p>
</div>
<div class="appointment-actions">
<span class="status amber">Chờ xác nhận</span>
<div>
<a class="btn small" href="@Url.Action("Details", "LichHen", new { area = "", id = 1 })">Xem chi tiết</a>
<button type="button" class="text-button" data-open-dialog="cancel-appointment">Hủy lịch</button>
</div>
</div>
</article>
<article class="appointment-card" data-status="HOAN_TAT">
<img src="@Url.Content("~/images/dragneel/vest.svg")" alt="Vest nam Modern Fit"/>
<div class="appointment-copy">
<h3>LH003 · Vest nam Modern Fit</h3>
<small>Size L · Đen</small>
<p>
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<rect x="3" y="5" width="18" height="16" rx="2"/>
<path d="M7 3v5m10-5v5M3 11h18"/>
</svg>18/10/2026 · 09:00</p>
<p>
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/>
<circle cx="12" cy="10" r="3"/>
</svg>Showroom DRAGNEEL · 86 Nguyễn Huệ, TP.HCM</p>
</div>
<div class="appointment-actions">
<span class="status neutral">Đã hoàn thành</span>
<div>
<a class="btn small" href="@Url.Action("Details", "LichHen", new { area = "", id = 1 })">Xem chi tiết</a>
</div>
</div>
</article>
</div>
<div class="empty" data-empty-status hidden>Chưa có lịch hẹn ở trạng thái này.</div>
<div class="note">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<circle cx="12" cy="12" r="9"/>
<path d="M12 6v6l4 2"/>
</svg>
<span>Lịch hẹn thử đồ chưa phải đơn thuê và chưa giữ trang phục.</span>
</div>
<div class="note">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<circle cx="12" cy="12" r="9"/>
<path d="M12 6v6l4 2"/>
</svg>
<span>Lịch đã xác nhận được hủy trước ít nhất 24 giờ. Sát giờ hẹn, vui lòng liên hệ cửa hàng.</span>
</div>
<dialog id="cancel-appointment" class="dialog">
<div class="dialog-body">
<span class="eyebrow">LỊCH HẸN THỬ ĐỒ</span>
<h2>Hủy lịch hẹn?</h2>
<p>Vui lòng cho biết lý do để cửa hàng điều chỉnh lịch tiếp khách.</p>
<form data-ui-only>
<label class="field">
<span>Lý do hủy</span>
<textarea name="LyDoHuy" maxlength="1000">
</textarea>
</label>
<div class="form-actions">
<button type="button" class="btn" data-close-dialog>Giữ lịch</button>
<button type="button" class="btn primary" disabled aria-disabled="true">Xác nhận hủy</button>
</div>
</form>
</div>
</dialog>
</section>
</div>
</div>
