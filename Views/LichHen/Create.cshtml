@using System
@using System.Collections.Generic

@{
    ViewData["Title"] = "Đặt lịch thử đồ";

    var cn = ViewBag.ChiNhanh as List<Dictionary<string, object?>>
             ?? new List<Dictionary<string, object?>>();

    var sp = ViewBag.SanPham as List<Dictionary<string, object?>>
             ?? new List<Dictionary<string, object?>>();

    string V(Dictionary<string, object?> x, string k)
        => Convert.ToString(x.GetValueOrDefault(k)) ?? "";

    var minLocal = DateTime.UtcNow
        .AddHours(7)
        .ToString("yyyy-MM-ddTHH:mm");

    var form = Context.Request.HasFormContentType
        ? Context.Request.Form
        : null;

    string Old(string key)
        => form == null ? "" : form[key].ToString();

    var selectedSanPham = Old("maSanPham");
    var selectedChiNhanh = Old("maChiNhanh");

    var hoTen = Old("hoTenLienHe");
    var soDienThoai = Old("soDienThoaiLienHe");
    var thoiDiemHen = Old("thoiDiemHen");
    var ghiChu = Old("ghiChu");
}

<link rel="stylesheet"
      href="~/css/diem-trang.css"
      asp-append-version="true" />

<main class="diem-page">
    <div class="diem-wrap">

        <p class="diem-eyebrow">
            DRAGNEEL · FITTING APPOINTMENT
        </p>

        <h1 class="diem-title">
            Đặt lịch thử đồ
        </h1>

        <p class="diem-lead">
            Chọn trang phục, chi nhánh và thời gian phù hợp.
            Lịch hẹn không tự giữ bộ trang phục.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="diem-error"
                 role="alert">
            </div>
        }

        <form asp-controller="LichHen"
              asp-action="Create"
              method="post"
              class="diem-form">

            @Html.AntiForgeryToken()

            <div class="diem-form-row">

                <label>
                    Sản phẩm

                    <select name="maSanPham" required>
                        <option value="">
                            -- Chọn sản phẩm --
                        </option>

                        @foreach (var x in sp)
                        {
                            var id = V(x, "MaSanPham");
                            var ten = V(x, "TenSanPham");
                            var kichThuoc = V(x, "KichThuoc");

                            if (id == selectedSanPham)
                            {
                                <option value="@id" selected>
                                    @ten · @kichThuoc
                                </option>
                            }
                            else
                            {
                                <option value="@id">
                                    @ten · @kichThuoc
                                </option>
                            }
                        }
                    </select>
                </label>
                <label>
                    Chi nhánh

                    <select name="maChiNhanh" required>
                        <option value="">
                            -- Chọn chi nhánh --
                        </option>

                        @foreach (var x in cn)
                        {
                            var id = V(x, "MaChiNhanh");
                            var ten = V(x, "TenChiNhanh");

                            if (id == selectedChiNhanh)
                            {
                                <option value="@id" selected>
                                    @ten
                                </option>
                            }
                            else
                            {
                                <option value="@id">
                                    @ten
                                </option>
                            }
                        }
                    </select>
                </label>

            </div>

            <div class="diem-form-row">

                <label>
                    Họ tên liên hệ

                    <input name="hoTenLienHe"
                           type="text"
                           maxlength="100"
                           value="@hoTen"
                           placeholder="Nhập họ và tên"
                           autocomplete="name"
                           required />
                </label>

                <label>
                    Số điện thoại liên hệ

                    <input name="soDienThoaiLienHe"
                           type="tel"
                           maxlength="20"
                           value="@soDienThoai"
                           placeholder="Nhập số điện thoại"
                           autocomplete="tel"
                           required />
                </label>

            </div>

            <label>
                Ngày giờ hẹn (giờ Việt Nam, 08:00–20:00)

                <input name="thoiDiemHen"
                       type="datetime-local"
                       min="@minLocal"
                       value="@thoiDiemHen"
                       required />
            </label>

            <label>
                Ghi chú

                <textarea name="ghiChu"
                          maxlength="2000"
                          rows="4"
                          placeholder="Nhập yêu cầu hoặc ghi chú (nếu có)">@ghiChu</textarea>
            </label>

            <button type="submit">
                Xác nhận lịch hẹn
            </button>

            <a class="diem-link"
               asp-controller="LichHen"
               asp-action="Index">
                Quay lại lịch hẹn
            </a>

        </form>

    </div>
</main>