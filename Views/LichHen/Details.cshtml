@using System
@using System.Collections.Generic
@model Dictionary<string,object?>
@{string V(string key)=>Convert.ToString(Model.GetValueOrDefault(key))??"";}
<link rel="stylesheet" href="~/css/diem-trang.css" asp-append-version="true" />
<main class="diem-page"><div class="diem-wrap"><p class="diem-eyebrow">DRAGNEEL · FITTING APPOINTMENT</p><h1 class="diem-title">Chi tiết lịch hẹn #@V("MaLichHen")</h1>
<div class="diem-card"><h2>@V("TenSanPham")</h2><p>Chi nhánh: @V("TenChiNhanh")</p><p>Địa chỉ: @V("DiaChi")</p><p>Ngày giờ: @Convert.ToDateTime(Model["ThoiDiemHen"]).AddHours(7).ToString("dd/MM/yyyy HH:mm") (VN)</p><p>Người liên hệ: @V("HoTenLienHe") · @V("SoDienThoaiLienHe")</p><p>Trạng thái: <strong>@V("TrangThai")</strong></p></div>
@if(new[]{"CHO_XAC_NHAN","DA_XAC_NHAN"}.Contains(V("TrangThai"))){<form asp-action="Cancel" method="post" class="diem-form diem-mt" data-confirm="Bạn có chắc muốn hủy lịch hẹn này?"><input type="hidden" name="id" value="@Model["MaLichHen"]"/><label>Lý do hủy lịch (bắt buộc)<textarea name="lyDo" maxlength="2000" required></textarea></label><button type="submit">Xác nhận hủy lịch</button></form>}
<p class="diem-mt"><a class="diem-link" asp-action="Index">← Quay lại danh sách</a></p></div></main>
