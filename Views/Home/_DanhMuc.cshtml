@model IReadOnlyList<DanhMucTrangChuViewModel>
@* Danh mục lấy từ bảng LoaiSanPham (các loại con); bấm vào sẽ lọc danh sách sản phẩm. *@
@{ var dau = Model.FirstOrDefault(); }
<section class="dragneel-section container">
<div class="dragneel-section-head" data-reveal><div><p class="dragneel-kicker">Chọn cho ngày của bạn</p><h2>Một điểm đến, đủ đầy lựa chọn</h2></div><a class="dragneel-text-link" href="@Url.Action("Index", "SanPham", new { area = "" })">Tất cả danh mục</a></div>
<div class="dragneel-categories">
<div class="dragneel-category-photo ph" data-reveal>@if (!string.IsNullOrEmpty(dau?.HinhAnh)) { <img id="catImg" src="@Url.Content("~" + dau!.HinhAnh)" alt="" onerror="this.remove()" /> }</div>
<ul class="dragneel-category-list">
@foreach (var (c, i) in Model.Select((c, i) => (c, i)))
{
    <li data-reveal data-delay="@(i * 100)"><a class="dragneel-category-item" href="@Url.Action("Index", "SanPham", new { area = "", category = c.TenLoai })" data-img="@(string.IsNullOrEmpty(c.HinhAnh) ? "" : Url.Content("~" + c.HinhAnh))"><span class="num">0@(i + 1)</span><span><h3>@c.TenLoai</h3><small>@c.MoTa</small></span></a></li>
}
</ul></div></section>
