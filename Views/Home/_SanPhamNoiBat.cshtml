@model IReadOnlyList<TheSanPhamViewModel>
@* Dùng chung thẻ _TheSanPham với trang danh sách để nhóm chỉ sửa một nơi. *@
<section class="dragneel-section container" id="san-pham">
<div class="dragneel-section-head" data-reveal><div><p class="dragneel-kicker">Tuyển chọn từ Dragneel</p><h2>Sản phẩm nổi bật</h2></div><a class="dragneel-text-link" href="@Url.Action("Index", "SanPham", new { area = "" })">Xem tất cả sản phẩm</a></div>
<div class="dragneel-product-grid">
@foreach (var (sanPham, i) in Model.Select((s, i) => (s, i)))
{
    <div data-reveal data-delay="@(i * 120)">@await Html.PartialAsync("_TheSanPham", sanPham)</div>
}
@if (Model.Count == 0) { <p class="dragneel-empty">Chưa có sản phẩm nổi bật. Hãy đánh dấu NoiBat = 1 cho sản phẩm trong bảng SanPham.</p> }
</div></section>
