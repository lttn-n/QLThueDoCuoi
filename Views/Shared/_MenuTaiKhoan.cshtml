<aside class="account-sidebar" aria-label="Menu tài khoản">
<div class="account-identity">
<div class="avatar">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<circle cx="12" cy="8" r="4"/>
<path d="M4 21a8 8 0 0 1 16 0"/>
</svg>
</div>
<div>
<b>@(User.Identity?.Name ?? "Tài khoản")</b>
<small>Khách hàng DRAGNEEL</small>
</div>
</div>
<a data-page-link="profile" class="" href="@Url.Action("Profile", "TaiKhoan", new { area = "" })">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<circle cx="12" cy="8" r="4"/>
<path d="M4 21a8 8 0 0 1 16 0"/>
</svg>Tài khoản của tôi</a>
<a data-page-link="orders" class="" href="@Url.Action("Index", "DonThue", new { area = "" })">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<rect x="5" y="4" width="14" height="17" rx="2"/>
<path d="M9 3h6v4H9zm0 8h6m-6 4h6"/>
</svg>Đơn thuê của tôi</a>
<a data-page-link="appointments" class="" href="@Url.Action("Index", "LichHen", new { area = "" })">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<rect x="3" y="5" width="18" height="16" rx="2"/>
<path d="M7 3v5m10-5v5M3 11h18"/>
</svg>Lịch hẹn thử đồ</a>
<form asp-area="" asp-controller="TaiKhoan" asp-action="Logout" method="post">
<button type="submit">
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M10 3H4v18h6m4-14 5 5-5 5M9 12h11"/>
</svg>Đăng xuất</button>
</form>
</aside>
