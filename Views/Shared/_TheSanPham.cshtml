@model QLThueDoCuoi.ViewModels.TheSanPhamViewModel
@{ var chiTiet = Url.Action("Details", "SanPham", new { area = "", id = Model.MaSanPham });
   var lichHen = Url.Action("Create", "LichHen", new { area = "", maSanPham = Model.MaSanPham });
   var gia = Model.GiaThue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));
   var hopThoai = "xem-nhanh-" + Model.MaSanPham; }
<article class="dragneel-product" data-product-card data-category="@Model.TenLoai" data-price="@Model.GiaThue.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-size="@Model.KichThuoc" data-name="@Model.TenSanPham.ToLowerInvariant()">
<div class="dragneel-product-media"><a class="dragneel-product-photo" href="@chiTiet"><img src="@Url.Content("~" + Model.HinhAnh)" alt="@Model.TenSanPham" width="450" height="610" loading="lazy" /><span class="dragneel-product-badge">@Model.Nhan.ToUpperInvariant()</span></a>
<button class="dragneel-product-like" type="button" aria-label="Đánh dấu @Model.TenSanPham" aria-pressed="false" data-mark-product="@Model.MaSanPham"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></button>
<button class="dragneel-product-open" type="button" data-open-dialog="@hopThoai" aria-haspopup="dialog" aria-controls="@hopThoai">XEM NHANH</button></div>
<div class="dragneel-product-info"><span>@Model.TenLoai.ToUpperInvariant()</span><h3><a href="@chiTiet">@Model.TenSanPham</a></h3><div class="dragneel-product-bottom"><p>@(gia)₫ <small>/ @Model.SoNgayTrongGoi ngày</small></p><a class="dragneel-product-cart" href="@(chiTiet + "#dat-thue")" aria-label="Chọn thông tin thuê @Model.TenSanPham" title="Chọn thông tin thuê"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg></a></div></div>
<dialog class="dragneel-quick-dialog" id="@hopThoai" aria-labelledby="@(hopThoai + "-tieu-de")"><button class="dragneel-quick-close" type="button" data-close-dialog aria-label="Đóng xem nhanh">×</button><div class="dragneel-quick-inner"><img src="@Url.Content("~" + Model.HinhAnh)" alt="@Model.TenSanPham" width="450" height="610" /><div class="dragneel-quick-copy"><span class="dragneel-kicker">@Model.TenLoai</span><h2 id="@(hopThoai + "-tieu-de")">@Model.TenSanPham</h2><strong>@(gia)₫ / @Model.SoNgayTrongGoi ngày</strong><p>Size tham khảo: @Model.KichThuoc.<br />Xem chi tiết để chọn trang phục và thông tin thuê phù hợp.</p><a class="dragneel-button" href="@chiTiet">Xem chi tiết <span>↗</span></a><a href="@lichHen">Đặt lịch thử mẫu này ↗</a></div></div></dialog>
</article>
