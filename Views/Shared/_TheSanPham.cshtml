@model QLThueDoCuoi.ViewModels.TheSanPhamViewModel
@{ var chiTiet = Url.Action("Details", "SanPham", new { area = "", id = Model.MaSanPham });
   var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); }
@* Thẻ sản phẩm dùng chung cho trang chủ và danh sách. data-* phục vụ bộ lọc trong site.js. *@
<article class="dragneel-product" data-product-card data-category="@Model.TenLoai" data-price="@Model.GiaThue.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-size="@Model.KichThuoc" data-name="@Model.TenSanPham.ToLowerInvariant()">
<a class="dragneel-product-photo ph" href="@chiTiet">
@if (!string.IsNullOrEmpty(Model.HinhAnh)) { <img src="@Url.Content("~" + Model.HinhAnh)" alt="@Model.TenSanPham" width="450" height="610" loading="lazy" onerror="this.remove()" /> }
@if (!string.IsNullOrEmpty(Model.HinhAnh2)) { <img class="dragneel-product-alt" src="@Url.Content("~" + Model.HinhAnh2)" alt="" width="450" height="610" loading="lazy" onerror="this.remove()" /> }
@if (!string.IsNullOrEmpty(Model.Nhan)) { <span class="dragneel-product-badge">@Model.Nhan.ToUpperInvariant()</span> }
<span class="dragneel-product-quick">Xem chi tiết</span>
</a>
<a class="dragneel-product-like" href="@(chiTiet)#dat-thue" aria-label="Chọn size, ngày và thêm @Model.TenSanPham vào giỏ thuê" title="Thêm vào giỏ thuê">@await Html.PartialAsync("_Icon", "bag")</a>
<div class="dragneel-product-info"><span>@Model.TenLoai.ToUpperInvariant()</span><h3><a href="@chiTiet">@Model.TenSanPham</a></h3>
<p class="price">@if (Model.GiaGoc is not null) { <s>@Model.GiaGoc.Value.ToString("N0", vn)₫</s> }<b>@Model.GiaThue.ToString("N0", vn)₫</b> <small>/ gói @Model.SoNgayTrongGoi ngày</small></p></div>
</article>
