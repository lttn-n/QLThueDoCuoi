@* Header dùng chung: logo, tìm kiếm, tài khoản, giỏ thuê (ViewComponent) và menu chính 2 cấp (ViewComponent). *@
@{
    var daDangNhap = User.Identity?.IsAuthenticated == true;
    var laKhach = User.IsInRole("KHACHHANG");
    var ten = User.Identity?.Name ?? "";
}
<header class="dragneel-header">
<div class="container dragneel-header-inner">
<a class="dragneel-logo" href="@Url.Action("Index", "Home", new { area = "" })" aria-label="DRAGNEEL – Trang chủ">Dragneel<small>WEDDING RENTAL</small></a>
<form class="search" role="search" action="@Url.Action("Index", "SanPham", new { area = "" })" method="get"><label class="visually-hidden" for="dragneel-search">Tìm trang phục</label><input id="dragneel-search" name="q" type="search" value="@(ViewContext.RouteData.Values["controller"]?.ToString() == "SanPham" ? Context.Request.Query["q"].ToString() : "")" placeholder="Tìm váy cưới, áo dài, phụ kiện..." autocomplete="off" /><button type="submit" class="search-btn" aria-label="Tìm kiếm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></button></form>
<div class="tools">
<details class="dropdown dragneel-account"><summary aria-label="Tài khoản">@await Html.PartialAsync("_Icon", "user")<span class="tool-text"><b>Tài khoản</b><small class="tool-name">@(daDangNhap ? ten : "Đăng nhập")</small></span></summary><div class="dropdown-menu">
@if (daDangNhap)
{
    if (laKhach)
    {
        <a href="@Url.Action("Profile", "TaiKhoan", new { area = "" })">@await Html.PartialAsync("_Icon", "user")Tài khoản của tôi</a>
        <a href="@Url.Action("Index", "DonThue", new { area = "" })">@await Html.PartialAsync("_Icon", "orders")Đơn thuê của tôi</a>
        <a href="@Url.Action("Index", "LichHen", new { area = "" })">@await Html.PartialAsync("_Icon", "calendar")Lịch hẹn thử đồ</a>
    }
    else if (User.IsInRole("ADMIN"))
    {
        <a href="@Url.Action("Index", "Home", new { area = "Admin" })">@await Html.PartialAsync("_Icon", "shield")Trang quản trị</a>
    }
    else if (User.IsInRole("NHANVIEN"))
    {
        <a href="@Url.Action("Index", "Home", new { area = "NhanVien" })">@await Html.PartialAsync("_Icon", "shield")Trang nhân viên</a>
    }
    <form asp-area="" asp-controller="TaiKhoan" asp-action="Logout" method="post"><button type="submit" class="menu-logout">@await Html.PartialAsync("_Icon", "logout")Đăng xuất</button></form>
}
else
{
    <a href="@Url.Action("Login", "TaiKhoan", new { area = "" })">@await Html.PartialAsync("_Icon", "login")Đăng nhập</a>
    <a href="@Url.Action("Register", "TaiKhoan", new { area = "" })">@await Html.PartialAsync("_Icon", "register")Đăng ký</a>
}
</div></details>
@await Component.InvokeAsync("GioThueTomTat")
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Đổi giao diện sáng/tối" title="Sáng / Tối"><svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg><svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
<button type="button" class="burger" aria-label="Mở menu" aria-expanded="false"><span></span><span></span><span></span></button>
</div></div>
@await Component.InvokeAsync("MenuChinh")
</header>
