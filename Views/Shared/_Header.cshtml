@* Header dùng chung: logo, tìm kiếm, tài khoản và giỏ thuê. *@
<header class="dragneel-header"><div class="container dragneel-header-inner">
<a class="dragneel-logo" href="@Url.Action("Index", "Home", new { area = "" })" aria-label="DRAGNEEL – Trang chủ">DRAGNEEL<small>WEDDING RENTAL</small></a>
<form class="dragneel-search" action="@Url.Action("Index", "SanPham", new { area = "" })" method="get"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><label class="visually-hidden" for="dragneel-search">Tìm trang phục</label><input id="dragneel-search" name="q" type="search" placeholder="Tìm váy cưới, áo dài, phụ kiện..." /></form>
<div class="dragneel-header-actions"><details class="dropdown dragneel-account"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg><span>Tài khoản<small>@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Đăng nhập")</small></span></summary><div class="dropdown-menu">
<a href="@Url.Action("Profile", "TaiKhoan", new { area = "" })">Tài khoản của tôi</a><a href="@Url.Action("Index", "DonThue", new { area = "" })">Đơn thuê của tôi</a><a href="@Url.Action("Index", "LichHen", new { area = "" })">Lịch hẹn thử đồ của tôi</a>
@if (User.Identity?.IsAuthenticated == true) { <form asp-area="" asp-controller="TaiKhoan" asp-action="Logout" method="post"><button type="submit">Đăng xuất</button></form> } else { <a href="@Url.Action("Login", "TaiKhoan", new { area = "" })">Đăng nhập</a><a href="@Url.Action("Register", "TaiKhoan", new { area = "" })">Đăng ký</a> }
</div></details>
<a class="dragneel-cart" href="@Url.Action("Index", "GioThue", new { area = "" })"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg><span>Giỏ thuê<small>Xem trang phục</small></span></a></div></div></header>
