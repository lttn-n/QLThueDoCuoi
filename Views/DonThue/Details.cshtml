@using System
@using System.Collections.Generic
@using System.Globalization
@model Dictionary<string,object?>
@{string V(Dictionary<string,object?> r,string k)=>Convert.ToString(r.GetValueOrDefault(k))??"";
string Money(object? x)=>Convert.ToDecimal(x??0).ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))+" đ";
var items=(List<Dictionary<string,object?>>)ViewBag.Items;}
<link rel="stylesheet" href="~/css/diem-trang.css" asp-append-version="true" />
<main class="diem-page"><div class="diem-wrap"><p class="diem-eyebrow">DRAGNEEL · MY RENTALS</p><h1 class="diem-title">Chi tiết đơn #@V(Model,"MaDonThue")</h1>
<div class="diem-card"><h2>Thông tin nhận hàng</h2><p>Ngày đặt: @Convert.ToDateTime(Model["NgayDat"]).AddHours(7).ToString("dd/MM/yyyy HH:mm")</p><p>Trạng thái: <strong>@V(Model,"TrangThai")</strong></p><p>Người nhận: @V(Model,"TenNguoiNhan")</p><p>Số điện thoại: @V(Model,"SoDienThoaiNhan")</p><p>Hình thức nhận: @V(Model,"HinhThucNhan")</p><p>Chi nhánh nhận: @V(Model,"TenChiNhanh")</p><p>Địa chỉ nhận: @V(Model,"DiaChiNhan")</p><p>Thanh toán: @V(Model,"PhuongThucThanhToan")</p></div>
<h2 class="diem-title diem-mt">Trang phục đã thuê</h2><div class="diem-grid">@foreach(var r in items){<article class="diem-card"><h2>@V(r,"TenSanPhamKhiThue")</h2><p>Size @V(r,"KichThuocKhiThue") · @V(r,"MauSacKhiThue") · Số lượng: @V(r,"SoLuong")</p><p>Ngày nhận: @Convert.ToDateTime(r["NgayNhan"]).ToString("dd/MM/yyyy")</p><p>Ngày trả dự kiến: @Convert.ToDateTime(r["NgayTraDuKien"]).ToString("dd/MM/yyyy")</p><p>Trạng thái: @V(r,"TrangThai")</p><p>Tiền thuê: <strong>@Money(r.GetValueOrDefault("TienThue"))</strong></p><p>Tiền cọc: @Money(r.GetValueOrDefault("TienCoc"))</p><p>Phí trả trễ: @Money(r.GetValueOrDefault("PhiTraTre")) · Phí hư hỏng: @Money(r.GetValueOrDefault("PhiHuHong"))</p></article>}</div>
<p class="diem-mt"><a class="diem-link" asp-action="Index">← Quay lại đơn thuê</a></p></div></main>
