@using System
@using System.Collections.Generic
@using System.Globalization
@model List<Dictionary<string,object?>>
@{ string V(Dictionary<string,object?> r,string k)=>Convert.ToString(r.GetValueOrDefault(k))??"";
   string Money(object? v)=>Convert.ToDecimal(v??0).ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))+" đ"; }
<link rel="stylesheet" href="~/css/diem-trang.css" asp-append-version="true" />
<main class="diem-page"><div class="diem-wrap"><p class="diem-eyebrow">DRAGNEEL · MY RENTALS</p><h1 class="diem-title">Đơn thuê của tôi</h1><p class="diem-lead">Theo dõi tình trạng đơn và thông tin thuê trang phục của bạn.</p>
@if(Model.Count==0){<div class="diem-empty"><h2>Chưa có đơn thuê</h2><p>Bắt đầu hành trình cùng Dragneel bằng cách chọn trang phục bạn yêu thích.</p><a asp-controller="SanPham" asp-action="Index" class="diem-btn">Khám phá sản phẩm</a></div>}
else{<div class="diem-grid">@foreach(var r in Model){<article class="diem-card"><p class="diem-eyebrow">MÃ ĐƠN #@V(r,"MaDonThue")</p><h2>Đơn thuê #@V(r,"MaDonThue")</h2><p>Ngày đặt: @Convert.ToDateTime(r["NgayDat"]).AddHours(7).ToString("dd/MM/yyyy HH:mm")</p><p>Trạng thái: <strong>@V(r,"TrangThai")</strong></p><p>Tiền thuê: <strong>@Money(r.GetValueOrDefault("TienThue"))</strong></p><p>Tiền cọc: @Money(r.GetValueOrDefault("TienCoc"))</p><p>Giảm giá: @Money(r.GetValueOrDefault("SoTienGiam"))</p><p>Phí giao nhận: @Money(r.GetValueOrDefault("PhiGiaoNhan"))</p><div class="diem-card-footer"><a class="diem-link" asp-action="Details" asp-route-id="@r["MaDonThue"]">Xem chi tiết →</a></div></article>}</div>}
</div></main>
