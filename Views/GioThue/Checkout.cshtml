@{ ViewBag.Title = "Đặt thuê"; ViewBag.PageKey = "checkout"; Layout = "~/Views/Shared/_LayoutKhachHang.cshtml"; }
@* Khung giao diện: dữ liệu mẫu tĩnh. Nhóm phụ trách thay bằng Model lấy từ SQL; chưa có xử lý ghi dữ liệu. *@
<div class="container">
<div class="breadcrumb">
<a class="" href="@Url.Action("Index", "Home", new { area = "" })">Trang chủ</a> <span>/</span> Giỏ thuê / Đặt thuê</div>
<div class="page-head">
<div>
<span class="eyebrow">KIỂM TRA TRƯỚC KHI GỬI</span>
<h1>Thông tin đặt thuê</h1>
<p>Xác nhận người nhận và cách nhận trang phục.</p>
</div>
</div>
<div class="cart-layout">
<div class="card">
<form data-ui-only>
<div class="form-grid">
<label class="field">
<span>Họ tên người nhận</span>
<input type="text" name="TenNguoiNhan" value="Lâm Thị Thanh Nhi" />
</label>
<label class="field">
<span>Số điện thoại</span>
<input type="text" name="SoDienThoaiNhan" value="" required/>
</label>
<label class="field">
<span>Hình thức nhận</span>
<select name="HinhThucNhan">
<option value="CUAHANG">Nhận tại cửa hàng</option>
<option value="GIAOHANG">Giao tận nơi</option>
</select>
</label>
<label class="field">
<span>Địa chỉ giao (nếu có)</span>
<input type="text" name="DiaChiNhan" value="" />
</label>
<label class="field"><span>Chi nhánh nhận tại cửa hàng</span><select name="MaChiNhanhNhan"><option value="1">DRAGNEEL - Chi nhánh 1</option><option value="2">DRAGNEEL - Chi nhánh 2</option></select></label>
<label class="field"><span>Phương thức thanh toán</span><select name="PhuongThucThanhToan"><option value="TIENMAT">Tiền mặt</option><option value="CHUYENKHOAN">Chuyển khoản</option></select></label>
<label class="field full">
<span>Ghi chú</span>
<textarea name="GhiChu">
</textarea>
</label>
</div>
<div class="form-actions">
<button type="button" class="btn primary" disabled aria-disabled="true">Xác nhận đặt thuê</button>
</div>
</form>
</div>
<div class="card">
<h2>Tóm tắt đơn thuê</h2>
<div class="summary-list">
<div>
<span>Tiền thuê</span>
<b>2.800.000₫</b>
</div>
<div>
<span>Phí giao nhận</span>
<b>Nhận tại showroom</b>
</div>
<div>
<span>Tiền cọc</span>
<b>2.000.000₫</b>
</div>
<div>
<span>Giảm giá</span>
<b>0₫</b>
</div>
<div class="total">
<span>Tổng ban đầu</span>
<span>4.800.000₫</span>
</div>
</div>
<small>Tiền cọc được theo dõi và hoàn riêng theo tình trạng đồ.</small>
</div>
</div>
</div>
