@model QLThueDoCuoi.ViewModels.DangKyViewModel
@{ ViewBag.Title = "Tạo tài khoản"; ViewBag.PageKey = "register"; Layout = "~/Views/Shared/_LayoutKhachHang.cshtml"; }
<div class="container">
<div class="auth-wrap">
<div class="card">
<span class="eyebrow">TRỞ THÀNH KHÁCH HÀNG</span>
<h1>Tạo tài khoản</h1>
<form asp-controller="TaiKhoan" asp-action="Register" method="post">
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<label class="field">
<span>Họ và tên</span>
<input asp-for="HoTen" autocomplete="name" />
<span asp-validation-for="HoTen" class="field-validation-error"></span>
</label>
<label class="field">
<span>Email</span>
<input asp-for="Email" type="email" autocomplete="email" />
<span asp-validation-for="Email" class="field-validation-error"></span>
</label>
<label class="field">
<span>Số điện thoại</span>
<input asp-for="SoDienThoai" type="tel" autocomplete="tel" />
<span asp-validation-for="SoDienThoai" class="field-validation-error"></span>
</label>
<label class="field">
<span>Mật khẩu</span>
<input asp-for="MatKhau" autocomplete="new-password" />
<span asp-validation-for="MatKhau" class="field-validation-error"></span>
</label>
<label class="field">
<span>Nhập lại mật khẩu</span>
<input asp-for="NhapLaiMatKhau" autocomplete="new-password" />
<span asp-validation-for="NhapLaiMatKhau" class="field-validation-error"></span>
</label>
<label class="checkline">
<input asp-for="DongYDieuKhoan" />Tôi đồng ý với điều khoản sử dụng.</label>
<span asp-validation-for="DongYDieuKhoan" class="field-validation-error"></span>
<div class="form-actions">
<button type="submit" class="btn primary">Tạo tài khoản</button>
</div>
</form>
<p>Đã có tài khoản? <a class="" href="@Url.Action("Login", "TaiKhoan", new { area = "" })">Đăng nhập</a>
</p>
</div>
</div>
</div>
