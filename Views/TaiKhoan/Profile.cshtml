@model QLThueDoCuoi.ViewModels.CapNhatThongTinCaNhanViewModel
@{
    ViewBag.Title = "Tài khoản của tôi"; ViewBag.PageKey = "profile"; Layout = "~/Views/Shared/_LayoutKhachHang.cshtml";
}
<div class="container">
    <div class="breadcrumb">
        <a class="" href="@Url.Action("Index", "Home", new { area = "" })">Trang chủ</a> <span>/</span> Tài khoản
    </div>
    <div class="account-layout">@await Html.PartialAsync("_MenuTaiKhoan")<section class="account-content">
        <div class="page-head">
            <div>
                <span class="eyebrow">KHÔNG GIAN CỦA BẠN</span>
                <h1>Tài khoản của tôi</h1>
                <p>Quản lý thông tin cá nhân và thông tin liên hệ.</p>
            </div>
        </div>
        <section class="card">
            <h2>Thông tin cá nhân</h2>
            @if (TempData["ThongBao"] is string thongBao)
            {
                <p role="status">@thongBao</p>
            }
            <form asp-action="Profile" method="post">
                <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
                <div class="form-grid">
                    <label class="field">
                        <span>Họ và tên</span>
                        <input asp-for="HoTen" />
                        <span asp-validation-for="HoTen" class="field-validation-error"></span>
                    </label>
                    <label class="field">
                        <span>Email</span>
                        <input asp-for="Email" placeholder="Nhập email" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </label>
                    <label class="field">
                        <span>Số điện thoại</span>
                        <input asp-for="SoDienThoai" type="tel" placeholder="Chưa cập nhật" />
                        <span asp-validation-for="SoDienThoai" class="field-validation-error"></span>
                    </label>
                    <label class="field">
                        <span>Địa chỉ</span>
                        <input asp-for="DiaChi" placeholder="Chưa cập nhật" />
                        <span asp-validation-for="DiaChi" class="field-validation-error"></span>
                    </label>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn primary">Lưu thay đổi</button>
                </div>
            </form>
        </section>
        <section class="card">
            <h2>Đổi mật khẩu</h2>
            <form asp-action="ChangePassword" method="post">
                <div class="form-grid">
                    <label class="field">
                        <span>Mật khẩu hiện tại</span>
                        <input type="password" name="MatKhauCu" value="" />
                    </label>
                    <label class="field">
                        <span>Mật khẩu mới</span>
                        <input type="password" name="MatKhauMoi" value="" />
                    </label>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn primary" disabled aria-disabled="true">Cập nhật mật
                        khẩu</button>
                    </div>
                </form>
            </section>
        </section>
    </div>
</div>
