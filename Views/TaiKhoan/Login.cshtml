@model QLThueDoCuoi.ViewModels.DangNhapViewModel
@{ ViewBag.Title = "Đăng nhập"; ViewBag.PageKey = "login"; Layout = "~/Views/Shared/_LayoutKhachHang.cshtml"; }
<div class="container">
<div class="auth-wrap">
<div class="card">
<span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span>
<h1>Đăng nhập</h1>
@if (TempData["ThongBao"] is string thongBao)
{
    <p role="status">@thongBao</p>
}
<form asp-controller="TaiKhoan" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<label class="field">
<span>Email hoặc số điện thoại</span>
<input asp-for="TenDangNhap" autocomplete="username" />
<span asp-validation-for="TenDangNhap" class="field-validation-error"></span>
</label>
<label class="field">
<span>Mật khẩu</span>
<input asp-for="MatKhau" autocomplete="current-password" />
<span asp-validation-for="MatKhau" class="field-validation-error"></span>
</label>
<div class="form-actions">
<button type="submit" class="btn primary">Đăng nhập</button>
</div>
</form>
<p>Chưa có tài khoản? <a class="" href="@Url.Action("Register", "TaiKhoan", new { area = "" })">Đăng ký ngay</a>
</p>
</div>
</div>
</div>
