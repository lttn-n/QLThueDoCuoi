@model DangNhapViewModel
@{ ViewBag.Title = "Đăng nhập"; ViewBag.PageKey = "login"; Layout = "~/Views/Shared/_LayoutKhachHang.cshtml"; }
<div class="container">
<div class="auth-wrap">
<div class="card">
<span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span>
<h1>Đăng nhập</h1>
<form asp-controller="TaiKhoan" asp-action="Login" asp-area="" method="post">
@if (!string.IsNullOrEmpty(Model.ReturnUrl) && ViewData.ModelState.IsValid)
{
<div class="alert info" role="status">Bạn cần đăng nhập để tiếp tục.</div>
}
<div asp-validation-summary="ModelOnly" class="alert error" role="alert"></div>
<input type="hidden" asp-for="ReturnUrl" />
<div class="field">
<label asp-for="TenDangNhap"></label>
<input asp-for="TenDangNhap" type="text" autocomplete="username" maxlength="254" pattern="[^@@\s]+@@[^@@\s]+\.[^@@\s]+|(\+?84|0)[0-9 .\-]{8,12}" data-msg-pattern="Nhập email hợp lệ hoặc số điện thoại 10 số (bắt đầu bằng 0)." required />
<span asp-validation-for="TenDangNhap" class="field-error"></span>
</div>
<div class="field">
<label asp-for="MatKhau"></label>
<div class="pw-wrap">
<input asp-for="MatKhau" autocomplete="current-password" maxlength="100" required />
@await Html.PartialAsync("_NutHienMatKhau")
</div>
<span asp-validation-for="MatKhau" class="field-error"></span>
</div>
<div class="login-extra">
<label class="checkline"><input type="checkbox" asp-for="GhiNho" />Ghi nhớ đăng nhập</label>
<a class="forgot-link" href="@Url.Action("QuenMatKhau", "TaiKhoan", new { area = "" })">Quên mật khẩu?</a>
</div>
<div class="form-actions">
<button type="submit" class="btn primary">Đăng nhập</button>
</div>
</form>
<p>Chưa có tài khoản? <a href="@Url.Action("Register", "TaiKhoan", new { area = "" })">Đăng ký ngay</a></p>
</div>
</div>
</div>
