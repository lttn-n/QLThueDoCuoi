@{ ViewBag.Title = "Chi tiết đơn thuê"; ViewBag.PageKey = "admin_order_detail"; Layout = "~/Areas/NhanVien/Views/Shared/_LayoutNhanVien.cshtml"; }
@* Khung giao diện: dữ liệu mẫu tĩnh. Nhóm phụ trách thay bằng Model lấy từ SQL; chưa có xử lý ghi dữ liệu. *@
<div class="page-head">
<div>
<span class="eyebrow">DRAGNEEL / NHÂN VIÊN</span>
<h1>Đơn thuê DH001</h1>
<p>Thông tin khách, bộ đồ được giữ và quyết toán.</p>
</div>
<span class="status blue">Đang thuê</span>
</div>
<div class="split">
<div>
<div class="card">
<h2>Trang phục và lịch thuê</h2>
<div class="list-row">
<img src="@Url.Content("~/images/dragneel/elodie.svg")" alt="Váy cưới Élodie"/>
<div>
<h3>Váy cưới Élodie</h3>
<small>Size M · Trắng · DRAGNEEL-2-1</small>
<b>25/10/2026 → 28/10/2026</b>
</div>
</div>
<div class="summary-list">
<div>
<span>Khách hàng</span>
<b>Lâm Thị Thanh Nhi</b>
</div>
<div>
<span>Cách nhận</span>
<b>Showroom DRAGNEEL</b>
</div>
</div>
<div class="button-row">
<button type="button" class="btn small" disabled aria-disabled="true">Xác nhận đơn</button>
<button type="button" class="btn small" disabled aria-disabled="true">Giao đồ</button>
<button type="button" class="btn small" disabled aria-disabled="true">Nhận trả</button>
<button type="button" class="btn small" disabled aria-disabled="true">Hoàn tất</button>
</div>
</div>
<div class="card">
<h2>Phụ phí khi trả</h2>
<form data-ui-only>
<div class="form-grid">
<label class="field">
<span>Phí trễ (đ)</span>
<input type="number" name="PhiTre" value="0" min="0"/>
</label>
<label class="field">
<span>Phí hư hỏng (đ)</span>
<input type="number" name="PhiHuHong" value="0" min="0"/>
</label>
<label class="field full">
<span>Tình trạng khi trả</span>
<textarea name="TinhTrangKhiTra">
</textarea>
</label>
</div>
<div class="form-actions">
<button type="button" class="btn primary" disabled aria-disabled="true">Lưu kết quả kiểm tra</button>
</div>
</form>
</div>
</div>
<div class="card">
<h2>Tóm tắt đơn thuê</h2>
<div class="summary-list">
<div>
<span>Tiền thuê</span>
<b>2.800.000₫</b>
</div>
<div>
<span>Phí giao nhận</span>
<b>Nhận tại showroom</b>
</div>
<div>
<span>Tiền cọc</span>
<b>2.000.000₫</b>
</div>
<div>
<span>Giảm giá</span>
<b>0₫</b>
</div>
<div class="total">
<span>Tổng ban đầu</span>
<span>4.800.000₫</span>
</div>
</div>
<small>Tiền cọc được theo dõi và hoàn riêng theo tình trạng đồ.</small>
</div>
</div>
