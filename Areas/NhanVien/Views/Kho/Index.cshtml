@{ ViewBag.Title = "Kho trang phục"; ViewBag.PageKey = "admin_inventory"; Layout = "~/Areas/NhanVien/Views/Shared/_LayoutNhanVien.cshtml"; }
@* Khung giao diện: dữ liệu mẫu tĩnh. Nhóm phụ trách thay bằng Model lấy từ SQL; chưa có xử lý ghi dữ liệu. *@
