<div class="card">
<h2>Thông tin danh mục</h2>
<form data-ui-only>
<label class="field">
<span>Tên danh mục</span>
<input type="text" name="TenLoaiSanPham" value="" />
</label>
<label class="field">
<span>Danh mục cha</span>
<select name="MaDanhMucCha">
<option>Không có (cấp 1)</option>
<option>Trang phục cưới</option>
</select>
</label>
<label class="field">
<span>Thứ tự</span>
<input type="number" name="ThuTu" value="0" />
</label>
<div class="form-actions">
<label>
<input type="checkbox" checked/> Hiển thị</label>
</div>
<div class="form-actions">
<button type="button" class="btn primary" disabled aria-disabled="true">Lưu danh mục</button>
</div>
</form>
</div>
</div>
