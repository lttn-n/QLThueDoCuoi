@using System
@using System.Collections.Generic
@using System.Globalization
@model List<Dictionary<string,object?>>
@{string V(Dictionary<string,object?> r,string k)=>Convert.ToString(r.GetValueOrDefault(k))??"";}
<link rel="stylesheet" href="~/css/diem-trang.css" asp-append-version="true" />
<main class="diem-page">
    <div class="diem-wrap"><div class="diem-top"><div>
        <p class="diem-eyebrow">ADMIN · DRAGNEEL</p>
        <h1 class="diem-title">Quản lý khuyến mãi</h1>
        <p class="diem-lead">Thêm, sửa và bật/tắt chương trình ưu đãi.</p>
        </div><a class="diem-btn" asp-action="Edit">+ Thêm khuyến mãi</a></div>
@if(TempData["DiemError"] is not null){<p class="diem-error">@TempData["DiemError"]</p>}@if(TempData["DiemOk"] is not null)
{<p class="diem-ok">@TempData["DiemOk"]</p>}
@if(Model.Count==0){<div class="diem-empty">Chưa có khuyến mãi nào.</div>}
else{<div class="diem-grid">@foreach(var r in Model)
    {<article class="diem-card">
        <p class="diem-eyebrow">@V(r,"MaUuDai")</p>
        <h2>@V(r,"TenKhuyenMai")</h2>
        <p>Hình thức: @V(r,"HinhThucGiam") · @V(r,"GiaTriGiam")</p>
        <p>Bắt đầu: @Convert.ToDateTime(r["NgayBatDau"]).AddHours(7).ToString("dd/MM/yyyy HH:mm") VN</p>
        <p>Kết thúc: @Convert.ToDateTime(r["NgayKetThuc"]).AddHours(7).ToString("dd/MM/yyyy HH:mm") VN</p>
        <p>Trạng thái: @(Convert.ToBoolean(r["TrangThai"])?"Đang bật":"Đã tắt")</p>
        <div class="diem-card-footer">
            <a class="diem-link" asp-action="Edit" asp-route-id="@r["MaKhuyenMai"]">Chỉnh sửa</a>
        <form asp-action="Toggle" method="post" data-confirm="Bạn chắc chắn muốn thay đổi trạng thái mã khuyến mãi?" class="diem-mt">
            <input type="hidden" name="id" value="@r["MaKhuyenMai"]"/>
            <input type="hidden" name="bat" value="@(Convert.ToBoolean(r["TrangThai"])?"false":"true")"/>
            <button type="submit">@(Convert.ToBoolean(r["TrangThai"])?"Tắt mã":"Bật mã")</button>
            </form>
        </div>
    </article>}
 </div>}
</div>
</main>
