@model List<Dictionary<string, object?>>

@{
    ViewBag.Title = "Tài khoản & vai trò"; ViewBag.PageKey = "admin_users"; Layout =
    "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    string V(Dictionary<string, object?> r, string key)
        => Convert.ToString(r.GetValueOrDefault(key)) ?? "";
    var ds = Model ?? new List<Dictionary<string, object?>>();
    var maTaiKhoanDangNhap = ViewBag.MaTaiKhoanDangNhap as int? ?? 0;
}
@* Dữ liệu được lấy từ dbo.TaiKhoan; thay đổi vai trò/trạng thái qua POST và xác nhận server. *@
<div class="page-head">
    <div>
        <span class="eyebrow">DRAGNEEL / QUẢN TRỊ</span>
        <h1>Tài khoản & vai trò</h1>
        <p>Chỉ admin quản lý quyền và trạng thái tài khoản.</p>
    </div>
</div>
@if (TempData["DiemOk"] is not null)
{
    <p class="diem-ok" role="status">@TempData["DiemOk"]</p>
}
@if (TempData["DiemError"] is not null)
{
    <p class="diem-error" role="alert">@TempData["DiemError"]</p>
}
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (ds.Count == 0)
            {
                <tr><td colspan="4">Không có tài khoản để hiển thị.</td></tr>
            }
            else
            {
                @foreach (var r in ds)
                {
                    var ma = Convert.ToInt32(r["MaTaiKhoan"]);
                    var laTaiKhoanDangNhap = ma == maTaiKhoanDangNhap;
                    var vaiTro = V(r, "VaiTro");
                    var hoatDong = Convert.ToBoolean(r["TrangThai"]);
                    var lienHe = V(r, "Email");
                    if (string.IsNullOrWhiteSpace(lienHe))
                    {
                        lienHe = V(r, "SoDienThoai");
                    }

                    <tr>
                        <td>
                            <b>@V(r, "HoTen")</b>
                            @if (!string.IsNullOrWhiteSpace(lienHe))
                            {
                                <small>@lienHe</small>
                            }
                        </td>
                        <td>
                            <form asp-action="CapNhatVaiTro" method="post" class="button-row">
                                <input type="hidden" name="maTaiKhoan" value="@ma" />
                                <select name="vaiTro"
                                        aria-label="Vai trò của @V(r, "HoTen")"
                                        disabled="@laTaiKhoanDangNhap">
                                    <option value="ADMIN" selected="@(vaiTro == "ADMIN")">ADMIN</option>
                                    <option value="NHANVIEN" selected="@(vaiTro == "NHANVIEN")">NHANVIEN</option>
                                    <option value="KHACHHANG" selected="@(vaiTro == "KHACHHANG")">KHACHHANG</option>
                                </select>
                                <button type="submit"
                                        class="btn small"
                                        disabled="@laTaiKhoanDangNhap">Cập nhật</button>
                            </form>
                        </td>
                        <td>
                            <span class="status @(hoatDong ? "green" : "red")">
                                @(hoatDong ? "Hoạt động" : "Đã khóa")
                            </span>
                        </td>
                        <td>
                            <form asp-action="@(hoatDong ? "KhoaTaiKhoan" : "MoKhoaTaiKhoan")"
                                  method="post"
                                  data-confirm="Bạn chắc chắn muốn @(hoatDong ? "khóa" : "mở khóa") tài khoản này?"
                                  style="display:inline">
                                <input type="hidden" name="maTaiKhoan" value="@ma" />
                                <button type="submit"
                                        class="btn small @(hoatDong ? "danger" : "")"
                                        disabled="@laTaiKhoanDangNhap">
                                    @(hoatDong ? "Khóa tài khoản" : "Mở khóa")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="note">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 6v6l4 2" />
    </svg>
    <span>Khách đăng ký luôn nhận vai trò KHACHHANG. Quyền quản trị phải được kiểm tra ở server.</span>
</div>
