<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<script>try{var t=localStorage.getItem('dragneel:theme');if(!t&&matchMedia('(prefers-color-scheme: dark)').matches)t='dark';if(t==='dark')document.documentElement.setAttribute('data-theme','dark')}catch(e){}</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewBag.Title · DRAGNEEL Admin</title>
<link rel="stylesheet" href="@Url.Content("~/css/site.css")"><link rel="stylesheet" href="@Url.Content("~/css/confirm.css")">@await RenderSectionAsync("styles", required: false)<link rel="stylesheet" href="@Url.Content("~/css/theme-dark.css")"></head>
<body class="admin-app" data-page="@ViewBag.PageKey">
<div class="admin-shell">
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_MenuAdmin.cshtml")
<div class="admin-body">
<header class="admin-topbar">
<button class="mobile-toggle" type="button" data-toggle-admin aria-label="Mở menu" aria-expanded="false">☰</button>
<span>DRAGNEEL / Admin</span>
<div class="right">
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Đổi giao diện sáng/tối" title="Sáng / Tối"><svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg><svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
<a href="@Url.Action("Index", "Home", new { area = "" })">Xem website →</a>
<b>@(User.Identity?.Name ?? "Tài khoản")</b>
</div>
</header>
<main class="admin-content" id="main-content">@RenderBody()</main>
</div>
</div>
<script src="@Url.Content("~/js/confirm.js")"></script><script src="@Url.Content("~/js/site.js")">
</script>@await RenderSectionAsync("scripts", required: false)</body>
</html>
